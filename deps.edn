{:paths ["src"]
 ;; ipld supplies the DAG-PB codec (the two framing rules a protobuf
 ;; encoder cannot express); multiformats supplies raw CIDv1 and sha2-256;
 ;; dev-protobuf supplies the UnixFS Data message, which — unlike the node
 ;; around it — is exactly what a deterministic protobuf encoder emits.
 :deps {io.github.kotoba-lang/io-ipld {:git/sha "c708e2b259e4ff445e4df74b8f8a7627028df748"}
        io.github.kotoba-lang/io-multiformats {:git/sha "b3b157e683a943d4f2e9362d9366cceefff3f656"}
        io.github.kotoba-lang/dev-protobuf {:git/sha "cfd0b29997abbcae918ec5e90fddd621dbfb97b6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
